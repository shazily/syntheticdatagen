# Synthetic Data Generator Configuration Example
# Copy this file to .env and customize as needed

# n8n Configuration
N8N_HOST=localhost
N8N_PORT=5678

# Ollama Configuration  
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.2:latest

# Web Server Configuration
WEB_PORT=80

# Optional: Enable debug mode
DEBUG=false

# FastAPI agentic rollout (touchless: all off / non-staging)
# DATAGEN_ENV=development
# AGENTIC_LINEAGE_ENABLED=0
# AGENTIC_LINEAGE_STAGE=staging
# AGENTIC_ESCROW_ENABLED=0
# AGENTIC_ESCROW_CANARY_PATH=/api/v1/canary/generate

# Lineage receipts (SHA-256); required when AGENTIC_LINEAGE_ENABLED=1 in staging
# SERVER_SECRET_SALT=replace-with-random-32-plus-chars

# x402 + Base Sepolia (API + Hardhat deploy from contracts/)
# DATAGEN_WALLET_ADDRESS=0x...
# DEPLOYER_PRIVATE_KEY=...   # testnet only; never commit real mainnet keys
# BASE_RPC_URL=https://sepolia.base.org
# X402_NETWORK=base-sepolia
# X402_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Escrow invoice (HTTP 402) — Base Sepolia defaults when unset
# BASE_CHAIN_ID=84532
# USDC_BASE_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# X402_ESCROW_CONTRACT=0x...   # after: npm run deploy:base-sepolia
# PAYOUT_WALLET=0x...
